        <div id="qrcodeCanvas"></div>
      </div>

      <div class="mt-3 text-[11px] font-mono text-slate-300">
        Germantown High School • Jamason Wade
      </div>
      <div class="mt-0.5 text-[10px] font-mono text-brand-amber">
        Wadejj@scsk12.org
      </div>
    </div>
  </div>

  <!-- JavaScript Logic -->
  <script>
    // Initialize Icons and QR code on DOM load
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();
      initQRCode();
    });

    // Generate Dynamic Client-Side QR Code matching current URL
    function initQRCode() {
      const qrTarget = document.getElementById("qrcodeCanvas");
      if (!qrTarget) return;
      qrTarget.innerHTML = "";
      
      const currentUrl = window.location.href.startsWith("http") 
        ? window.location.href 
        : "https://germantownhigh.scsk12.org";

      new QRCode(qrTarget, {
        text: currentUrl,
        width: 180,
        height: 180,
        colorDark: "#0B0F14",
        colorLight: "#FFFFFF",
        correctLevel: QRCode.CorrectLevel.M
      });
    }

    // Modal Control
    function openQRModal() {
      const modal = document.getElementById('qrModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeQRModal() {
      const modal = document.getElementById('qrModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // Direct vCard (.vcf) Generator with accurate contact info
    function downloadVCard() {
      const vCardString = [
        "BEGIN:VCARD",
        "VERSION:3.0",
        "FN:Jamason Wade",
        "N:Wade;Jamason;;;",
        "ORG:Germantown High School Automotive Technology",
        "TITLE:Automotive Technology Instructor (MLR) | OSHA 10 Certified",
        "EMAIL;TYPE=INTERNET,WORK:Wadejj@scsk12.org",
        "ADR;TYPE=WORK:;;7653 Old Poplar Pike;Germantown;TN;38138;USA",
        "NOTE:SEMA 2026 Industry Partner - CTE Maintenance & Light Repair Program",
        "URL:https://germantownhigh.scsk12.org",
        "END:VCARD"
      ].join("\r\n");

      const blob = new Blob([vCardString], { type: "text/vcard;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const downloadLink = document.createElement("a");
      downloadLink.href = url;
      downloadLink.setAttribute("download", "Jamason_Wade_Germantown_Auto.vcf");
      document.body.appendChild(downloadLink);
      downloadLink.click();
      document.body.removeChild(downloadLink);
      URL.revokeObjectURL(url);
    }

    // Collect selected categories
    function getCheckedInterests() {
      const checkedBoxes = document.querySelectorAll('input[name="interest"]:checked');
      return Array.from(checkedBoxes).map(cb => cb.value);
    }

    // Handle Form Email Draft
    function handleBoothSubmit(event) {
      event.preventDefault();

      const name = document.getElementById('repName').value.trim();
      const company = document.getElementById('repCompany').value.trim();
      const email = document.getElementById('repEmail').value.trim();
      const booth = document.getElementById('repBooth').value.trim();
      const interests = getCheckedInterests().join(', ') || 'General SEMA Education Partnership';
      const notes = document.getElementById('repNotes').value.trim();

      const subject = encodeURIComponent(`SEMA Industry Partnership: ${company} x Germantown High Automotive`);
      const body = encodeURIComponent(
        `Hi Jamason,\n\n` +
        `Great meeting you at SEMA 2026! Here are our educational partnership details:\n\n` +
        `• Representative: ${name}\n` +
        `• Company / Brand: ${company}\n` +
        `• Contact Email: ${email}\n` +
        `• Booth # / Direct Phone: ${booth || 'N/A'}\n` +
        `• Partnership Tracks: ${interests}\n` +
        `• Follow-up Notes: ${notes || 'Looking forward to following up regarding educational opportunities for your MLR students.'}\n\n` +
        `Best regards,\n${name}\n${company}`
      );

      // Launch native email client with Wadejj@scsk12.org prefilled
      window.location.href = `mailto:Wadejj@scsk12.org?subject=${subject}&body=${body}`;
    }

    // Copy Lead Summary to Clipboard
    function copyLeadToClipboard() {
      const name = document.getElementById('repName').value.trim() || '[Rep Name]';
      const company = document.getElementById('repCompany').value.trim() || '[Company]';
      const email = document.getElementById('repEmail').value.trim() || '[Email]';
      const booth = document.getElementById('repBooth').value.trim() || '[Booth #]';
      const interests = getCheckedInterests().join(', ') || 'All Educational Tracks';
      const notes = document.getElementById('repNotes').value.trim() || 'Follow up after show';

      const summaryText = `SEMA Lead: ${name} (${company}) | Email: ${email} | Booth/Phone: ${booth} | Tracks: ${interests} | Notes: ${notes} | Recipient: Jamason Wade (Wadejj@scsk12.org)`;

      const tempTextarea = document.createElement("textarea");
      tempTextarea.value = summaryText;
      document.body.appendChild(tempTextarea);
      tempTextarea.select();
      try {
        document.execCommand('copy');
        const toast = document.getElementById('copyToast');
        const label = document.getElementById('copyBtnLabel');
        toast.classList.remove('hidden');
        label.textContent = "Copied to Clipboard!";
        setTimeout(() => {
          toast.classList.add('hidden');
          label.textContent = "Copy Lead Info to Clipboard";
        }, 3000);
      } catch (e) {
        console.error("Clipboard copy failed:", e);
      }
      document.body.removeChild(tempTextarea);
    }
  </script>
</body>
</html>
```
